# Copy this file to .env.compose and change values only for your local machine.
# It is intentionally ignored by Git. Do not use production credentials here.
POSTGRES_DB=aditsystem
POSTGRES_USER=aditsystem
POSTGRES_PASSWORD=local-development-password
POSTGRES_PORT=5432
API_PORT=8000

# pgAdmin — gestor web de la base de datos (http://localhost:5050)
PGADMIN_EMAIL=admin@aditsystem.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

APP_NAME=ADITSYSTEM Backend
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type

JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=aditsystem-backend
JWT_AUDIENCE=aditsystem-clients
EVENT_QR_ISSUER=aditsystem-event-qr
EVENT_QR_AUDIENCE=aditsystem-event-scanner
EVENT_QR_TTL_SECONDS=120
DEFAULT_CHECKIN_RADIUS_METERS=100
MAX_ALLOWED_GEO_PRECISION_METERS=100
# El bootstrap/seed exige BOOTSTRAP_PASSWORD en el proceso que lo ejecuta.
# No incluya cuentas, contraseñas ni datos personales en este archivo.
