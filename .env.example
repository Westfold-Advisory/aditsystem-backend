# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_NAME=ADITSYSTEM Backend
APP_ENV=local          # local | development | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ─────────────────────────────────────────────
# Database
# Secret — obtain from AWS Secrets Manager in non-local envs.
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aditsystem

# ─────────────────────────────────────────────
# JWT (RS256 key pair — paths to PEM files)
# Secrets — never commit the actual key files.
# Generate with: openssl genrsa -out keys/jwt-private.pem 2048
#                openssl rsa -in keys/jwt-private.pem -pubout -out keys/jwt-public.pem
# ─────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=aditsystem-backend
JWT_AUDIENCE=aditsystem-clients

# ─────────────────────────────────────────────
# Event QR tokens
# ─────────────────────────────────────────────
EVENT_QR_ISSUER=aditsystem-event-qr
EVENT_QR_AUDIENCE=aditsystem-event-scanner
EVENT_QR_TTL_SECONDS=120

# ─────────────────────────────────────────────
# Geo / check-in
# ─────────────────────────────────────────────
DEFAULT_CHECKIN_RADIUS_METERS=100
MAX_ALLOWED_GEO_PRECISION_METERS=100

# ─────────────────────────────────────────────
# CORS — comma-separated list of allowed origins.
# Never use "*" alongside credentials.
#
# Development origins:
#   Local dev server : http://localhost:3000
#   S3 frontend (dev): http://aditsystem-dev-810626480386-frontend.s3-website-us-east-1.amazonaws.com
#   Custom domain    : https://aditsystem.ervic.pro  (add once DNS is enabled)
#
# Set all active origins together in one variable:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://aditsystem-dev-810626480386-frontend.s3-website-us-east-1.amazonaws.com
# ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://aditsystem-dev-810626480386-frontend.s3-website-us-east-1.amazonaws.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type
